{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lab/renovate-config"
  ],
  "baseBranchPatterns": ["main"],
  "assignAutomerge": true,
  "assignees": ["@albdev-bot"],
  "reviewers": ["@naoalb"],
  "flux": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ]
  },
  "customDatasources": {
    "talos-factory": {
      "defaultRegistryUrlTemplate": "https://factory.talos.dev/versions",
      "format": "json",
      "transformTemplates": ["{\"releases\": [$.{\"version\": $}]}"]
    }
  },
  "customManagers": [
    {
      "description": "Process Talos Factory installer images",
      "customType": "regex",
      "managerFilePatterns": ["/talos\\/.*\\.yaml(?:\\.j2)?$/"],
      "matchStrings": [
        "factory\\.talos\\.dev\\/[^/]+\\/[^:]+:(?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "custom.talos-factory",
      "versioningTemplate": "semver",
      "depNameTemplate": "siderolabs/talos"
    }
  ],
  "packageRules": [
    {
      "description": "Never pin digests on any Flux-managed resource",
      "matchManagers": ["flux"],
      "pinDigests": false
    },
    {
      "description": "Do not propose digest updates for Flux-managed resources",
      "matchManagers": ["flux"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Auto-merge high-cadence packages weekly",
      "matchDatasources": ["docker"],
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "schedule": ["before 6am on Monday"]
    },
    {
      "description": "Talos Factory installer images",
      "addLabels": ["renovate/talos"],
      "matchDatasources": ["custom.talos-factory"],
      "semanticCommitScope": "container",
      "commitMessageTopic": "{{depName}}"
    }
  ]
}