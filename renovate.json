{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lab/renovate-config",
    "local>lab/k8s//.renovate/autoMerge.json5",
    "local>lab/k8s//.renovate/grafanaDashboards.json5",
    "local>lab/k8s//.renovate/registryAliases.json5",
    "local>lab/k8s//.renovate/talosFactory.json5",
    "local>lab/k8s//.renovate/groups.json5",
    "local>lab/k8s//.renovate/versioning.json5"
  ],
  "baseBranchPatterns": ["main"],
  "assignAutomerge": true,
  "assignees": ["@albdev-bot"],
  "reviewers": ["@naoalb"],
  "flux": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Never pin digests on any Flux-managed resource",
      "matchManagers": ["flux"],
      "pinDigests": false
    },
    {
      "description": "Do not propose digest updates for Flux-managed resources",
      "matchManagers": ["flux"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    }
  ]
}